# https://aistudio.google.com/apikey 에서 무료로 발급받은 Gemini API 키를 넣으면
# AI 피드백(3번) 기능이 동작합니다. 신용카드 등록 없이 발급 가능합니다.
GEMINI_API_KEY=

# /admin 페이지 접근 비밀번호 (직접 정하세요. 비워두면 /admin이 잠깁니다)
ADMIN_PASSWORD=

# https://upstash.com 에서 무료로 만든 Redis 데이터베이스의 REST URL/토큰.
# 여기 값을 채우면 /admin에서 저장한 내용이 Vercel 배포본에서도 실시간으로 반영돼요.
# 비워두면 로컬 파일(data/site-content.json)에만 저장됩니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
